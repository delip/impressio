{
  "name": "impressio",
  "version": "0.1.0",
  "description": "Physically inspired letterpress + cardstock rendering for canvas and the DOM",
  "type": "module",
  "main": "dist/impressio.js",
  "module": "dist/impressio.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/impressio.js",
      "default": "./dist/impressio.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=dist/impressio.js && esbuild src/index.ts --bundle --format=iife --global-name=Impressio --target=es2020 --minify --outfile=dist/impressio.global.js && tsc -p . --emitDeclarationOnly",
    "typecheck": "tsc -p . --noEmit",
    "gallery": "npm run build && node scripts/gallery.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delip/impressio.git"
  },
  "homepage": "https://github.com/delip/impressio#readme",
  "bugs": {
    "url": "https://github.com/delip/impressio/issues"
  },
  "keywords": [
    "letterpress",
    "canvas",
    "paper",
    "skeuomorphism",
    "typography",
    "rendering",
    "latex"
  ]
}
